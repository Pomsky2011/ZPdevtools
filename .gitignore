# Built tools land in executables/
executables/*
!executables/.gitkeep

# DOS/Windows build output
BIN/
bin/
*.exe
*.EXE
*.obj
*.OBJ

# C compiler: binary, Flex/Bison output
c_compiler/def88186cc
c_compiler/lex.yy.c
c_compiler/lexer.c
c_compiler/parser.tab.c
c_compiler/parser.tab.h
c_compiler/parser.output

# Objects, libraries
*.o
*.a
*.so
*.dylib
*.dll

# Assembler/linker output (nothing built is tracked)
*.bin
*.rom
*.ROM

# Python
__pycache__/
*.py[cod]

# Editors, OS, scratch
.vscode/
.idea/
*.swp
*~
*.bak
.DS_Store
*.log
tmp/
*.wav
*.numbers
*.elf
*.zpb
*.img
